# Copy to .env (gitignored), chmod 600, and supply private values.
POSTGRES_PASSWORD=
NEXT_PRIVATE_DATABASE_URL=postgresql://documenso:PASSWORD@database:5432/documenso
NEXTAUTH_SECRET=
NEXT_PRIVATE_ENCRYPTION_KEY=
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=
NEXT_PRIVATE_SIGNING_PASSPHRASE=
NEXT_PRIVATE_SMTP_HOST=
NEXT_PRIVATE_SMTP_PORT=587
NEXT_PRIVATE_SMTP_USERNAME=
NEXT_PRIVATE_SMTP_PASSWORD=
NEXT_PRIVATE_SMTP_FROM_ADDRESS=
# Set false only long enough to create the first owner account.
NEXT_PUBLIC_DISABLE_SIGNUP=true
